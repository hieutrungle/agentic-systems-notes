digraph ExperimentControl {
    graph [rankdir=TB, bgcolor=transparent, pad=0.15, nodesep=0.14, ranksep=0.23, newrank=true];
    node [shape=box, style="rounded,filled", fillcolor="#edf3f7", color="#325167", fontname="sans-serif", fontsize=16, margin="0.16,0.06", width=1.4];
    edge [color="#325167", arrowsize=0.72, fontname="sans-serif", fontsize=14];

    subgraph cluster_fixed {
        label="Fixed batch";
        labelloc=t;
        fontname="sans-serif bold";
        fontsize=17;
        style=rounded;
        color="#9aaab9";
        margin=9;
        batch [label="Pick all configs"];
        one [label="Run 1"];
        two [label="Run 2"];
        three [label="Run 3"];
        four [label="Run 4"];
        five [label="Run 5"];
        select [label="Select best score"];
        fixed_stop [label="Stop", fillcolor="#f2f4f6"];

        batch -> one -> two -> three -> four -> five -> select -> fixed_stop;
    }

    subgraph cluster_adaptive {
        label="Adaptive search";
        labelloc=t;
        fontname="sans-serif bold";
        fontsize=17;
        style=rounded;
        color="#9aaab9";
        margin=9;
        choose [label="Choose config", fillcolor="#dce9fa"];
        run [label="Run experiment"];
        observe [label="Observe metrics"];
        update [label="Update state"];
        decide [label="Continue?", fillcolor="#fdf0d7", color="#986b26"];
        adaptive_stop [label="Stop", fillcolor="#f2f4f6"];

        choose -> run -> observe -> update -> decide;
        decide -> choose [xlabel=" Yes ", constraint=false, color="#1f4f8f", fontcolor="#1f4f8f", penwidth=2.5];
        decide -> adaptive_stop [label=" no"];
    }

    { rank=same; batch; choose; }
    batch -> choose [style=invis];
}
